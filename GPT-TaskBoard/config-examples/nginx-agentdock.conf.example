# Replace the example domain and certificate paths before use.
# The SSH reverse tunnel must listen only on VPS loopback port 18765.

server {
    listen 80;
    listen [::]:80;
    server_name agentdock.example.com;

    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name agentdock.example.com;

    ssl_certificate     /etc/letsencrypt/live/agentdock.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentdock.example.com/privkey.pem;

    # A single catch-all preserves /mcp, /register, /oauth/* and
    # /.well-known/* without path rewriting.
    location / {
        proxy_pass http://127.0.0.1:18765;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
