# Manual/public deployment example only.
# Prefer the official desktop installer for ordinary macOS/Windows use.

AGENTDOCK_HOST=127.0.0.1
AGENTDOCK_PORT=8765

AGENTDOCK_OAUTH_ENABLED=true
AGENTDOCK_SERVER_URL=https://agentdock.example.com

# Generate and store real values outside Git.
AGENTDOCK_OAUTH_PASSWORD=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
AGENTDOCK_OAUTH_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
